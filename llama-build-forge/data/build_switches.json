{
  "schema_version": 1,
  "source": "ggml-org/llama.cpp CMake options; intended to be refreshed against upstream",
  "switches": [
    {"name":"CMAKE_BUILD_TYPE","type":"string","default":"Release","description":"CMake build configuration.","use_cases":["release builds","debugging"],"example":"-DCMAKE_BUILD_TYPE=Release"},
    {"name":"GGML_NATIVE","type":"bool","default":"ON","description":"Tune CPU compilation for the build host.","use_cases":["maximum host-local CPU performance"],"example":"-DGGML_NATIVE=ON"},
    {"name":"GGML_CPU_ALL_VARIANTS","type":"bool","default":"OFF","description":"Build multiple CPU variants instead of one native target.","use_cases":["portable CPU binaries"],"example":"-DGGML_CPU_ALL_VARIANTS=ON"},
    {"name":"GGML_OPENMP","type":"bool","default":"ON","description":"Enable OpenMP CPU parallelism.","use_cases":["CPU throughput"],"example":"-DGGML_OPENMP=ON"},
    {"name":"GGML_CUDA","type":"bool","default":"OFF","description":"Enable NVIDIA CUDA backend.","use_cases":["NVIDIA GPU inference"],"example":"-DGGML_CUDA=ON"},
    {"name":"GGML_CUDA_GRAPHS","type":"bool","default":"ON","description":"Use CUDA graphs in llama.cpp.","use_cases":["CUDA graph execution where supported"],"example":"-DGGML_CUDA_GRAPHS=ON"},
    {"name":"GGML_CUDA_FA","type":"bool","default":"ON","description":"Compile CUDA FlashAttention kernels.","use_cases":["attention acceleration"],"example":"-DGGML_CUDA_FA=ON"},
    {"name":"GGML_CUDA_FA_ALL_QUANTS","type":"bool","default":"OFF","description":"Compile all quantized variants for CUDA FlashAttention.","use_cases":["broad quantized attention coverage"],"example":"-DGGML_CUDA_FA_ALL_QUANTS=ON"},
    {"name":"GGML_CUDA_NCCL","type":"bool","default":"ON","description":"Enable NVIDIA Collective Communication Library integration.","use_cases":["multi-GPU / distributed CUDA"],"example":"-DGGML_CUDA_NCCL=ON"},
    {"name":"GGML_HIP","type":"bool","default":"OFF","description":"Enable AMD HIP/ROCm backend.","use_cases":["AMD GPU inference"],"example":"-DGGML_HIP=ON"},
    {"name":"GGML_HIP_GRAPHS","type":"bool","default":"ON","description":"Enable HIP graphs.","use_cases":["AMD graph execution"],"example":"-DGGML_HIP_GRAPHS=ON"},
    {"name":"GGML_HIP_RCCL","type":"bool","default":"OFF","description":"Enable ROCm RCCL collective communication.","use_cases":["multi-GPU ROCm"],"example":"-DGGML_HIP_RCCL=ON"},
    {"name":"GGML_HIP_ROCWMMA_FATTN","type":"bool","default":"OFF","description":"Enable rocWMMA for HIP FlashAttention.","use_cases":["supported AMD architectures"],"example":"-DGGML_HIP_ROCWMMA_FATTN=ON"},
    {"name":"GGML_VULKAN","type":"bool","default":"OFF","description":"Enable Vulkan backend.","use_cases":["cross-vendor GPU support","fallback GPU backend"],"example":"-DGGML_VULKAN=ON"},
    {"name":"GGML_VULKAN_VALIDATE","type":"bool","default":"OFF","description":"Enable Vulkan validation layers.","use_cases":["debugging Vulkan builds"],"example":"-DGGML_VULKAN_VALIDATE=ON"},
    {"name":"GGML_VULKAN_DEBUG","type":"bool","default":"OFF","description":"Enable Vulkan debug output.","use_cases":["Vulkan debugging"],"example":"-DGGML_VULKAN_DEBUG=ON"},
    {"name":"GGML_VULKAN_CHECK_RESULTS","type":"bool","default":"OFF","description":"Run Vulkan operation checks.","use_cases":["backend validation"],"example":"-DGGML_VULKAN_CHECK_RESULTS=ON"},
    {"name":"GGML_SYCL","type":"bool","default":"OFF","description":"Enable SYCL backend for accelerator devices.","use_cases":["Intel GPU with oneAPI/SYCL"],"example":"-DGGML_SYCL=ON"},
    {"name":"GGML_SYCL_TARGET","type":"string","default":"INTEL","description":"Select SYCL target family.","use_cases":["Intel SYCL builds"],"example":"-DGGML_SYCL_TARGET=INTEL"},
    {"name":"GGML_SYCL_DEVICE_ARCH","type":"string","default":"","description":"Specify SYCL device architecture when needed.","use_cases":["explicit accelerator targeting"],"example":"-DGGML_SYCL_DEVICE_ARCH=..."},
    {"name":"GGML_SYCL_F16","type":"bool","default":"OFF","description":"Use 16-bit floats for SYCL calculations.","use_cases":["supported Intel GPUs"],"example":"-DGGML_SYCL_F16=ON"},
    {"name":"GGML_SYCL_GRAPH","type":"bool","default":"ON","description":"Enable graphs in SYCL backend.","use_cases":["Intel graph execution"],"example":"-DGGML_SYCL_GRAPH=ON"},
    {"name":"GGML_SYCL_SUPPORT_LEVEL_ZERO","type":"bool","default":"ON","description":"Use Level Zero through SYCL backend.","use_cases":["Intel GPU"],"example":"-DGGML_SYCL_SUPPORT_LEVEL_ZERO=ON"},
    {"name":"GGML_SYCL_DNN","type":"bool","default":"ON","description":"Enable oneDNN in SYCL backend.","use_cases":["Intel acceleration"],"example":"-DGGML_SYCL_DNN=ON"},
    {"name":"GGML_OPENCL","type":"bool","default":"OFF","description":"Enable OpenCL backend.","use_cases":["OpenCL-compatible accelerators"],"example":"-DGGML_OPENCL=ON"},
    {"name":"GGML_OPENCL_PROFILING","type":"bool","default":"OFF","description":"Enable OpenCL profiling at the cost of overhead.","use_cases":["OpenCL tuning"],"example":"-DGGML_OPENCL_PROFILING=ON"},
    {"name":"GGML_OPENCL_EMBED_KERNELS","type":"bool","default":"ON","description":"Embed OpenCL kernels in the executable.","use_cases":["self-contained OpenCL builds"],"example":"-DGGML_OPENCL_EMBED_KERNELS=ON"},
    {"name":"GGML_OPENCL_USE_ADRENO_KERNELS","type":"bool","default":"ON","description":"Use optimized Adreno kernels.","use_cases":["Qualcomm/Adreno"],"example":"-DGGML_OPENCL_USE_ADRENO_KERNELS=ON"},
    {"name":"GGML_OPENVINO","type":"bool","default":"OFF","description":"Enable OpenVINO backend.","use_cases":["Intel CPU/GPU/NPU via OpenVINO"],"example":"-DGGML_OPENVINO=ON"},
    {"name":"GGML_RPC","type":"bool","default":"OFF","description":"Enable RPC backend support.","use_cases":["remote backend execution"],"example":"-DGGML_RPC=ON"},
    {"name":"GGML_BACKEND_DL","type":"bool","default":"OFF","description":"Build backends as dynamically loadable libraries.","use_cases":["one binary with backend plugins","heterogeneous deployments"],"example":"-DGGML_BACKEND_DL=ON"},
    {"name":"BUILD_SHARED_LIBS","type":"bool","default":"OFF","description":"Build shared libraries when supported.","use_cases":["shared library packaging"],"example":"-DBUILD_SHARED_LIBS=ON"},
    {"name":"GGML_BUILD_TESTS","type":"bool","default":"ON","description":"Build ggml tests.","use_cases":["CI","validation"],"example":"-DGGML_BUILD_TESTS=ON"},
    {"name":"GGML_BUILD_EXAMPLES","type":"bool","default":"ON","description":"Build ggml examples and related tools.","use_cases":["developer builds"],"example":"-DGGML_BUILD_EXAMPLES=ON"}
  ]
}
