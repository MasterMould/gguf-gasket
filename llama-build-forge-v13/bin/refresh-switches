#!/usr/bin/env python3
import json, re, sys, urllib.request
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
OUT=ROOT/'data'/'build_switches.json'
URL='https://raw.githubusercontent.com/ggml-org/llama.cpp/master/ggml/CMakeLists.txt'
try:
    text=urllib.request.urlopen(URL, timeout=20).read().decode('utf-8','replace')
except Exception as e:
    print(f'Unable to refresh upstream catalog: {e}', file=sys.stderr)
    print(f'Keeping existing catalog at {OUT}')
    raise SystemExit(2)
patterns=[
    (r'option\\((GGML_[A-Z0-9_]+)\\s+"([^"]*)"\\s+([^\\)]+)\\)', 'option'),
    (r'set\\s*\\((GGML_[A-Z0-9_]+)\\s+([^\\s\\)]+)\\s+CACHE\\s+(?:STRING|BOOL)\\s+"([^"]*)"', 'set-cache'),
]
items={}
for m in re.finditer(patterns[0][0], text, re.I|re.S):
    name, desc, default=m.group(1), ' '.join(m.group(2).split()), m.group(3).strip()
    if name not in items:
        items[name]={'name':name,'type':'bool','default':default,'description':desc,'use_cases':[],'example':f'-D{name}={default}'}
for m in re.finditer(patterns[1][0], text, re.I|re.S):
    name, default, desc=m.group(1), m.group(2), ' '.join(m.group(3).split())
    if name not in items:
        items[name]={'name':name,'type':'string','default':default,'description':desc,'use_cases':[],'example':f'-D{name}={default}'}
# Include top-level LLAMA options too, since users asked for all known build switches.
for m in re.finditer(r'option\\((LLAMA_[A-Z0-9_]+)\\s+"([^"]*)"\\s+([^\\)]+)\\)', text, re.I|re.S):
    name, desc, default=m.group(1), ' '.join(m.group(2).split()), m.group(3).strip()
    items.setdefault(name, {'name':name,'type':'bool','default':default,'description':desc,'use_cases':[],'example':f'-D{name}={default}'})

obj={'schema_version':2,'generated_at':__import__('datetime').datetime.now(__import__('datetime').timezone.utc).isoformat(),'source_url':URL,'description':'Auto-extracted CMake build options from upstream llama.cpp/ggml. Descriptions are upstream cache/option descriptions; use_cases may be curated locally.','switches':sorted(items.values(), key=lambda x:x['name'])}
OUT.write_text(json.dumps(obj, indent=2)+'\n')
print(f'Wrote {len(obj["switches"])} build switches to {OUT}')
